{
  "expo": {
    "name": "Simmerli",
    "slug": "clerk-expo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/simmerli-icon.png",
    "scheme": "clerkexpo",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        }
      },
      "bundleIdentifier": "com.datphandp333.simmerli",
      "usesAppleSignIn": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/simmerli-splash.png",
        "backgroundColor": "#E7EEE2",
        "monochromeImage": "./assets/images/simmerli-splash.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/simmerli-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/simmerli-splash.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#ffffff"
          }
        }
      ],
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-status-bar",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose a photo to identify ingredients for your pantry.",
          "cameraPermission": "Take a photo to identify ingredients for your pantry.",
          "microphonePermission": false
        }
      ],
      "@clerk/expo-google-signin",
      "@clerk/expo",
      "expo-apple-authentication"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
